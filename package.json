{
  "name": "mb-ai",
  "version": "0.5.0",
  "description": "MerchantBots harness launcher — wraps Claude Code with the mb-ai profile.",
  "type": "module",
  "bin": { "mb-ai": "dist/index.js" },
  "files": ["dist"],
  "engines": { "node": ">=18.17" },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test:it": "npm run build && node scripts/it-smoke.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.2.0",
    "@napi-rs/keyring": "^1.1.6",
    "commander": "^12.1.0",
    "execa": "^9.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
